+func TestReviewOrphanJournal(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 12*time.Second)
+	defer cancel()
+	f := newVoteFixture(t, ctx, time.Minute)
+	id := uuid.New()
+	topic := "televote-" + id.String()
+	createTopic(t, ctx, f.reader, topic)
+	old := entity.Poll{ID: id, Version: 1, Topic: topic, Partitions: partitions}
+	for n := range partitions {
+		if err := f.writer.MarkClosed(ctx, old, int32(n)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	h, err := app.NewHandler(ctx, f.pool, f.writer, time.Second, app.AdminConfig{Token: "review-only", Partitions: partitions})
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+	now := time.Now().UTC().Truncate(time.Microsecond)
+	ends := now.Add(2 * time.Second)
+	body, err := json.Marshal(map[string]any{"id": id, "question": "New broadcast", "opens_at": now.Add(-time.Minute), "closes_at": ends, "choices": []string{"A", "B"}, "min_choices": 1, "max_choices": 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, srv.URL+"/admin/polls", bytes.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Authorization", "Bearer review-only")
+	res, err := srv.Client().Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Body.Close()
+	if res.StatusCode != 201 {
+		t.Fatalf("create status %d", res.StatusCode)
+	}
+	code, _ := sendBallot(t, ctx, srv.Client(), srv.URL+"/api/polls/"+id.String()+"/votes", "11111111111111111111111111111111", []int{1})
+	if code != 202 {
+		t.Fatalf("vote status %d", code)
+	}
+	time.Sleep(time.Until(ends))
+	if err := h.CountClosedPoll(ctx, id); err != nil {
+		t.Fatal(err)
+	}
+	result, err := pollsrepo.New(f.pool).Results(ctx, id)
+	if err != nil || result.Ballots == nil {
+		t.Fatalf("result: %+v, %v", result, err)
+	}
+	t.Logf("pre-existing CLOSE for same ID and version: create=%d vote=%d status=%s ballots=%d", res.StatusCode, code, result.Status, *result.Ballots)
+	if *result.Ballots != 0 {
+		t.Fatal("old CLOSE did not mask accepted vote")
+	}
+}
