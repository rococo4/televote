+func TestReviewColdOpen(t *testing.T) {
+	opens := time.Date(2030, 1, 1, 12, 0, 0, 0, time.UTC)
+	now := opens.Add(-time.Millisecond)
+	p := entity.Poll{ID: uuid.New(), OpensAt: opens, ClosesAt: opens.Add(time.Minute), MinChoices: 1, MaxChoices: 1, Choices: map[int]struct{}{1: {}}}
+	writer := &recordingPublisher{}
+	s := voting.New(nil, writer, func() time.Time { return now })
+	h := NewHandler(s, func(ctx context.Context, id uuid.UUID) error {
+		now = opens.Add(time.Millisecond)
+		return s.Register(p, true)
+	})
+	r := httptest.NewRequest(http.MethodPost, "/api/polls/"+p.ID.String()+"/votes", strings.NewReader(`{"token":"00000000000000000000000000000000","choices":[1]}`))
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code != http.StatusAccepted || len(writer.events) != 1 {
+		t.Fatalf("observed status=%d events=%d", w.Code, len(writer.events))
+	}
+	t.Logf("complete body at opens_at-1ms; status=%d recorded_at=opens_at+%v", w.Code, writer.events[0].ReceivedAt.Sub(opens))
+}
