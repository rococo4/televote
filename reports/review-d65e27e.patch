+func TestReviewExpiredUnpublishedDraft(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	defer cancel()
+	f := newVoteFixture(t, ctx, time.Minute)
+	id := uuid.New()
+	tname := "televote-" + id.String()
+	createTopic(t, ctx, f.reader, tname)
+	now := time.Now().UTC().Truncate(time.Microsecond)
+	spec := entity.CreatePoll{ID: id, Question: "expired unpublished", Choices: []string{"A", "B"}, OpensAt: now.Add(-time.Minute), ClosesAt: now.Add(500 * time.Millisecond), MinChoices: 1, MaxChoices: 1}
+	if _, published, err := pollsrepo.New(f.pool).Draft(ctx, spec, partitions); err != nil || published {
+		t.Fatalf("reserve unpublished: %v", err)
+	}
+	h, err := app.NewHandler(ctx, f.pool, f.writer, time.Second, app.AdminConfig{Token: "review-only", Partitions: partitions})
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+	time.Sleep(time.Until(spec.ClosesAt.Add(20 * time.Millisecond)))
+	b, err := json.Marshal(map[string]any{"id": id, "question": spec.Question, "opens_at": spec.OpensAt, "closes_at": spec.ClosesAt, "choices": spec.Choices, "min_choices": 1, "max_choices": 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, srv.URL+"/admin/polls", bytes.NewReader(b))
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Authorization", "Bearer review-only")
+	res, err := srv.Client().Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Body.Close()
+	t.Logf("first publication of expired draft: HTTP %d", res.StatusCode)
+	if res.StatusCode != 201 {
+		t.Fatal("expected observation changed")
+	}
+}
