@@ -17,0 +20,29 @@
+
+var diagnosticStart = time.Now()
+var diagnosticCalls atomic.Uint64
+var diagnosticOutput = func() *os.File {
+	f, err := os.Create(os.Getenv("TELEVOTE_DIAG_LOG"))
+	if err != nil {
+		panic(err)
+	}
+	return f
+}()
+
+type timingLog struct{}
+
+func (timingLog) Level() kgo.LogLevel {
+	if time.Since(diagnosticStart) <= 16*time.Second {
+		return kgo.LogLevelDebug
+	}
+	return kgo.LogLevelInfo
+}
+func (timingLog) Log(level kgo.LogLevel, msg string, kv ...any) {
+	if time.Since(diagnosticStart) <= 8*time.Second || level <= kgo.LogLevelInfo {
+		fmt.Fprintf(diagnosticOutput, "%12.6f KAFKA %s %s %v\n", time.Since(diagnosticStart).Seconds(), level, msg, kv)
+	}
+}
+func diagnosticVote(seq uint64, step string, start time.Time, err error) {
+	if seq <= 8 || seq%1000 == 0 || err != nil || (step == "callback" && time.Since(start) >= time.Second) {
+		fmt.Fprintf(diagnosticOutput, "%12.6f VOTE %s seq=%d duration=%v err=%v\n", time.Since(diagnosticStart).Seconds(), step, seq, time.Since(start), err)
+	}
+}
